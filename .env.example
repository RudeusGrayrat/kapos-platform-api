DATABASE_URL="postgresql://postgres:password@localhost:5432/basti?schema=public"

JWT_ACCESS_SECRET="replace-with-a-secure-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace-with-a-secure-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Llave estable para cifrar el token Nubefact/PSE guardado desde Finanzas -> Facturacion.
# No la cambies despues de guardar credenciales reales o de prueba.
NUBEFACT_TOKEN_ENCRYPTION_KEY="replace-with-a-different-long-random-secret"
FRONTEND_ORIGINS="http://localhost:3001"

PORT=3000
